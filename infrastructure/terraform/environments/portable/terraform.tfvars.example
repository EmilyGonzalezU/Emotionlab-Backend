aws_region           = "us-east-1"
environment          = "portable"
project_name         = "emotionlab"
create_lambda_role   = true
existing_lambda_role_arn = ""
email_sender_address = ""
email_sender_name    = "EmotionLab - Sistema de Evaluacion"
ses_source_arn       = ""
enable_ses_identity  = false
model_image_uri      = ""
unity_data_url       = ""
cors_allowed_origins = "http://localhost:5173,http://127.0.0.1:5173,null"
model_ecr_repository_name = "emotionlab-model-portable"
s3_versioning_enabled = true
s3_kms_key_arn       = ""
dynamodb_pitr_enabled = true
backend_log_retention_days = 90
migration_log_retention_days = 180
enable_frontend_hosting = false
frontend_bucket_name = ""
frontend_domain_name = ""
frontend_acm_certificate_arn = ""
