# ==========================================
# EmotionLab - Backend
# Environment configuration example
# ==========================================

# ------------------------------------------
# Flask
# ------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5000

# ------------------------------------------
# AWS
# ------------------------------------------
AWS_REGION=us-east-1
STORAGE_BACKEND=s3
S3_DATA_BUCKET=emotionlab-dev-data

# ------------------------------------------
# Amazon Cognito
# ------------------------------------------
COGNITO_USER_POOL_ID=us-east-1_REPLACE_ME
COGNITO_APP_CLIENT_ID=REPLACE_ME

# ------------------------------------------
# DynamoDB
# ------------------------------------------
DYNAMODB_USERS_TABLE=emotionlab-dev-users
DYNAMODB_PARTICIPANTS_TABLE=emotionlab-dev-participants
DYNAMODB_SESSIONS_TABLE=emotionlab-dev-sessions
DYNAMODB_REPORT_REQUESTS_TABLE=emotionlab-dev-report-requests
DYNAMODB_AUDIT_LOGS_TABLE=emotionlab-dev-audit-logs

# ------------------------------------------
# S3
# ------------------------------------------
S3_SESSIONS_RAW_BUCKET=emotionlab-dev-sessions-raw
S3_REPORT_PDFS_BUCKET=emotionlab-dev-report-pdfs

# ------------------------------------------
# SES, CloudWatch y Lambda
# ------------------------------------------
SES_SENDER_ADDRESS=
CLOUDWATCH_LOG_GROUP=
CLOUDWATCH_ENABLED=false
LAMBDA_SYNC_FUNCTION_NAME=
LAMBDA_MODEL_FUNCTION_NAME=

# ------------------------------------------
# API
# ------------------------------------------
API_URL=http://127.0.0.1:5000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AWS_UNITY_DATA_URL=

# ------------------------------------------
# IA
# ------------------------------------------
MODEL_PATH=ia/modelo_pipeline.pkl
