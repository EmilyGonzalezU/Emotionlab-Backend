# ==========================================
# EmotionLab - Backend
# Environment configuration example
# ==========================================

# ------------------------------------------
# Flask
# ------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5000

# ------------------------------------------
# AWS
# ------------------------------------------
AWS_REGION=us-east-1
STORAGE_BACKEND=s3
S3_DATA_BUCKET=emotionlab-dev-data

# ------------------------------------------
# Amazon Cognito
# ------------------------------------------
COGNITO_USER_POOL_ID=us-east-1_REPLACE_ME
COGNITO_APP_CLIENT_ID=REPLACE_ME

# ------------------------------------------
# DynamoDB
# ------------------------------------------
DYNAMODB_USERS_TABLE=emotionlab-dev-users
DYNAMODB_PARTICIPANTS_TABLE=emotionlab-dev-participants
DYNAMODB_SESSIONS_TABLE=emotionlab-dev-sessions
DYNAMODB_TRACKINGS_TABLE=emotionlab-dev-trackings
DYNAMODB_REPORT_REQUESTS_TABLE=emotionlab-dev-report-requests
DYNAMODB_AUDIT_LOGS_TABLE=emotionlab-dev-audit-logs
DYNAMODB_SESSION_CODE_RATE_LIMITS_TABLE=emotionlab-dev-session-code-rate-limits
# Solo para DynamoDB Local; déjalo vacío en dev/AWS.
DYNAMODB_ENDPOINT_URL=
# Se usa para seudonimizar IPs y request_token en el rate limit local.
SESSION_CODE_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# ------------------------------------------
# S3
# ------------------------------------------
S3_SESSIONS_RAW_BUCKET=emotionlab-dev-sessions-raw
S3_REPORT_PDFS_BUCKET=emotionlab-dev-report-pdfs

# ------------------------------------------
# SES, CloudWatch y Lambda
# ------------------------------------------
SES_SENDER_ADDRESS=
CLOUDWATCH_LOG_GROUP=
CLOUDWATCH_ENABLED=false
LAMBDA_SYNC_FUNCTION_NAME=
LAMBDA_MODEL_FUNCTION_NAME=

# ------------------------------------------
# API
# ------------------------------------------
API_URL=http://127.0.0.1:5000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AWS_UNITY_DATA_URL=

# ------------------------------------------
# IA (Modelo único V2 - K-Means congelado)
# ------------------------------------------
# Motor de inferencia: "remote" (producción) o "local" (desarrollo/pruebas
# con scikit-learn 1.6.1). No existe fallback automático entre ambos.
EMOTION_MODEL_V2_MODE=local
# URL del servicio remoto de inferencia V2 (requerida si MODE=remote).
EMOTION_MODEL_V2_API_URL=
# Timeout (segundos) de las llamadas al servicio remoto de inferencia.
EMOTION_MODEL_V2_TIMEOUT=15

# ------------------------------------------
# Prueba funcional con los lentes (test_captura.py)
# ------------------------------------------
# URL del backend usada por la herramienta de consola. Si se omite, la
# herramienta usa API_URL y, en su defecto, http://127.0.0.1:5000.
EMOTIONLAB_API_URL=http://127.0.0.1:5000
# Token Bearer ya emitido (opcional). Si se define, no se pide usuario ni
# contraseña.
EMOTIONLAB_TOKEN=
# Correo del especialista para autenticarse interactivamente (opcional).
EMOTIONLAB_EMAIL=
# Espera automática (segundos) antes de confirmar la transferencia (0 = preguntar).
EMOTIONLAB_TRANSFER_WAIT_SECONDS=0
# Timeout de las peticiones HTTP, en segundos.
EMOTIONLAB_HTTP_TIMEOUT=60

# ------------------------------------------
# API Gateway de los lentes (integración externa)
# ------------------------------------------
# EmotionLab se comunica con la cuenta AWS de los lentes por HTTPS mediante
# su API Gateway. NO se usan credenciales ni DynamoDB de esa cuenta.
# Ruta usada: POST {LENS_API_BASE_URL}/session/confirm
# La ruta principal /captures usa validateOnly=false y no depende del modo
# validateOnly=true, que se conserva para el endpoint compatible de resolución.
LENS_API_BASE_URL=https://cntbcwfel0.execute-api.us-east-1.amazonaws.com/prod
# Timeout (segundos) de las llamadas al API Gateway del lente.
LENS_API_TIMEOUT=15

# Nota: DYNAMODB_LENS_SESSIONS_TABLE y DYNAMODB_LENS_DISPLAY_CODES_TABLE
# quedan como variables LEGACY. El flujo nuevo (validar/confirmar PIN) ya no
# las requiere: la validación se realiza contra el API Gateway del lente.
